# WeekFlow environment contract — spec §19.2
# Copy to apps/api/.env and apps/web/.env.local and fill in real values.
# This file holds NAMES AND SAFE PLACEHOLDERS ONLY. Never commit real secrets.

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# API port locally; Railway injects PORT in deployment.
PORT=4000
LOG_LEVEL=info

# ─── Database (secret) ────────────────────────────────────────────────────────
# Railway PostgreSQL connection string for this environment.
DATABASE_URL=postgresql://user:password@host:5432/weekflow?schema=public
# Disposable database used by the integration suite. MUST NOT be the dev database.
TEST_DATABASE_URL=postgresql://user:password@host:5432/weekflow_test?schema=public
# Only if the chosen connection setup needs a non-pooled URL for migrations.
# DIRECT_URL=

# ─── Session (secret) ─────────────────────────────────────────────────────────
# High-entropy, independently generated. e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-high-entropy-secret
JWT_ISSUER=weekflow-api
JWT_AUDIENCE=weekflow-web
JWT_EXPIRES_IN=8h

# ─── Cookie (spec §12.3 — same-origin via Vercel rewrite proxy) ───────────────
AUTH_COOKIE_NAME=weekflow_session
# false only for local HTTP development; true on every HTTPS deployment.
COOKIE_SECURE=false
# lax under the proxy topology. `none` requires COOKIE_SECURE=true and is not used.
COOKIE_SAME_SITE=lax
# Leave UNSET for a host-only cookie. Do not widen without a tested reason.
# COOKIE_DOMAIN=

# ─── Browser origin policy (spec §12.4) ───────────────────────────────────────
# Exact origins, comma separated. No paths, no wildcards.
# In production this is the Vercel origin itself (same-origin requests still send Origin).
CORS_ORIGINS=http://localhost:3000

# ─── Reporting calendar (spec §4) ─────────────────────────────────────────────
APP_TIMEZONE=Asia/Colombo
REPORT_DEADLINE_HOUR=9
REPORT_DEADLINE_MINUTE=0

# ─── Web (public — bundled into the browser build) ────────────────────────────
# Dev: absolute URL to the API. Production: the relative "/api/v1" proxied by Vercel.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# Rewrite target used by next.config.ts in deployment only.
# API_PROXY_TARGET=https://weekflow-api.up.railway.app

# ─── Demo seed (spec §17.5) ───────────────────────────────────────────────────
# Guard: the seed refuses to run unless this is explicitly true.
SEED_DEMO=false
# Synthetic demo credential. Never reuse a personal or production password.
SEED_DEMO_PASSWORD=replace-with-a-synthetic-demo-password
